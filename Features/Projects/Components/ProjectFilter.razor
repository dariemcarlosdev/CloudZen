@* Project Filter Component - Modern UI/UX with enhanced visual design *@

@* Restrained brand-aligned project filter: teal palette, system controls, no gradients/double shadows. *@

<div class="bg-white rounded-2xl border border-gray-200/80 p-6 md:p-7 mb-10">
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 mb-5">
        <div class="flex items-center gap-2.5">
            <i class="bi bi-funnel text-teal-cyan-aqua-600 text-base" aria-hidden="true"></i>
            <h4 class="text-sm font-semibold text-gray-900 tracking-tight">Filter projects</h4>
        </div>
        @if (!string.IsNullOrEmpty(SelectedStatus) || !string.IsNullOrEmpty(SelectedProjectType))
        {
            <button @onclick="ClearFilters"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-teal-cyan-aqua-700 transition-colors">
                <i class="bi bi-x-lg text-[10px]" aria-hidden="true"></i>
                Clear all
            </button>
        }
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
        <!-- Status -->
        <div class="flex flex-col gap-1.5">
            <label for="filter-status" class="text-[11px] font-semibold text-gray-600 uppercase tracking-[0.12em]">Status</label>
            <div class="relative">
                <select id="filter-status"
                        @bind="SelectedStatus"
                        @bind:after="OnFilterChanged"
                        class="w-full appearance-none pl-3.5 pr-9 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800
                               hover:border-teal-cyan-aqua-300
                               focus:outline-none focus:ring-2 focus:ring-teal-cyan-aqua-600/30 focus:border-teal-cyan-aqua-500
                               transition-colors duration-200 cursor-pointer">
                    <option value="">All statuses</option>
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Planning">Planning</option>
                </select>
                <i class="bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none" aria-hidden="true"></i>
            </div>
        </div>

        <!-- Project Type -->
        <div class="flex flex-col gap-1.5">
            <label for="filter-type" class="text-[11px] font-semibold text-gray-600 uppercase tracking-[0.12em]">Project type</label>
            <div class="relative">
                <select id="filter-type"
                        @bind="SelectedProjectType"
                        @bind:after="OnFilterChanged"
                        class="w-full appearance-none pl-3.5 pr-9 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800
                               hover:border-teal-cyan-aqua-300
                               focus:outline-none focus:ring-2 focus:ring-teal-cyan-aqua-600/30 focus:border-teal-cyan-aqua-500
                               transition-colors duration-200 cursor-pointer">
                    <option value="">All types</option>
                    <option value="Side Project">Side projects</option>
                    <option value="Customer">Customer projects</option>
                    <option value="AI Automation">AI automation</option>
                </select>
                <i class="bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none" aria-hidden="true"></i>
            </div>
        </div>
    </div>

    @* Active filter chips — minimal, dismissible *@
    @if (!string.IsNullOrEmpty(SelectedStatus) || !string.IsNullOrEmpty(SelectedProjectType))
    {
        <div class="mt-5 pt-5 border-t border-gray-100 flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-semibold text-gray-500 uppercase tracking-[0.12em] mr-1">Active</span>
            @if (!string.IsNullOrEmpty(SelectedStatus))
            {
                <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1 py-1 bg-teal-cyan-aqua-50 text-teal-cyan-aqua-700 text-xs font-medium rounded-md border border-teal-cyan-aqua-100">
                    <span>Status: @SelectedStatus</span>
                    <button @onclick="ClearStatusFilter"
                            class="inline-flex items-center justify-center w-4 h-4 rounded hover:bg-teal-cyan-aqua-100 transition-colors"
                            aria-label="Clear status filter">
                        <i class="bi bi-x text-sm" aria-hidden="true"></i>
                    </button>
                </span>
            }
            @if (!string.IsNullOrEmpty(SelectedProjectType))
            {
                <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1 py-1 bg-teal-cyan-aqua-50 text-teal-cyan-aqua-700 text-xs font-medium rounded-md border border-teal-cyan-aqua-100">
                    <span>Type: @SelectedProjectType</span>
                    <button @onclick="ClearProjectTypeFilter"
                            class="inline-flex items-center justify-center w-4 h-4 rounded hover:bg-teal-cyan-aqua-100 transition-colors"
                            aria-label="Clear project type filter">
                        <i class="bi bi-x text-sm" aria-hidden="true"></i>
                    </button>
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Currently selected status filter value.
    /// </summary>
    private string SelectedStatus { get; set; } = string.Empty;

    /// <summary>
    /// Currently selected project type filter value.
    /// </summary>
    private string SelectedProjectType { get; set; } = string.Empty;

    /// <summary>
    /// Event callback that fires when filter values change.
    /// Passes the selected status and project type back to the parent component.
    /// </summary>
    [Parameter]
    public EventCallback<(string Status, string ProjectType)> OnFilterChange { get; set; }

    /// <summary>
    /// Invokes the filter change callback with current filter values.
    /// </summary>
    private async Task OnFilterChanged()
    {
        await OnFilterChange.InvokeAsync((SelectedStatus, SelectedProjectType));
    }

    /// <summary>
    /// Clears all active filters and triggers filter change event.
    /// </summary>
    private async Task ClearFilters()
    {
        SelectedStatus = string.Empty;
        SelectedProjectType = string.Empty;
        await OnFilterChanged();
    }

        /// <summary>
    /// Clears the status filter and triggers filter change event.
    /// </summary>
    private async Task ClearStatusFilter()
    {
        SelectedStatus = string.Empty;
        await OnFilterChanged();
    }

    /// <summary>
    /// Clears the project type filter and triggers filter change event.
    /// </summary>
    private async Task ClearProjectTypeFilter()
    {
        SelectedProjectType = string.Empty;
        await OnFilterChanged();
    }
}
