
@* 
    Case Studies Component

    PURPOSE:
    Showcases real-world project case studies with measurable results and business impact.
    Dynamically loads featured projects from IProjectService and presents them in an 
    attractive, customer-friendly format. Text transformations delegated to ICaseStudyService.
*@

<section id="cases" class="py-16 md:py-20 bg-gradient-to-br from-teal-cyan-aqua-50/25 via-teal-cyan-aqua-50/10 to-teal-cyan-aqua-50/15 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <!-- Section Header -->
        <div class="text-center mb-10 md:mb-16">
            <h2 class="reveal text-4xl font-bold mb-4 text-gray-800">
                Real Results, Real Impact
            </h2>
            <div class="reveal w-16 h-1 bg-teal-cyan-aqua-600 mx-auto mb-6 rounded-full"></div>
            <p class="reveal text-gray-600 text-lg max-w-5xl mx-auto">
                See how some businesses have ditched slow systems, automated what used to take hours, and delivered real, measurable growth.
            </p>
        </div>

        <!-- Project Cards Grid - Responsive: 1 col mobile, 2 cols tablet, 3 cols desktop -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
            @{ var caseIndex = 0; }
            @foreach (var project in _caseStudyProjects)
            {
                <!-- Project card — restrained B2B treatment: no lift, accent-bar reveal on hover -->
                <div class="reveal-scale reveal-delay-@((caseIndex % 6) + 1) group relative bg-white rounded-2xl border border-teal-cyan-aqua-200/40 overflow-hidden
                            transition-[border-color,box-shadow] duration-300 ease-out
                            hover:border-teal-cyan-aqua-300 hover:shadow-[0_10px_30px_-15px_rgba(64,103,107,0.22)]">

                    <!-- Accent bar — fixed sliver at rest, grows full-width on hover -->
                    <span aria-hidden="true"
                          class="absolute top-0 left-0 right-0 h-[2px] bg-teal-cyan-aqua-500 origin-left
                                 scale-x-[0.16] group-hover:scale-x-100
                                 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>

                    <!-- Header row: title + restrained outline category chip -->
                    <div class="px-6 pt-7 pb-4 flex items-start justify-between gap-3">
                        <h3 class="font-bold text-lg text-gray-900 leading-snug tracking-tight">
                            @CaseStudyService.GetShortTitle(project.Name)
                        </h3>
                        <span class="shrink-0 inline-flex items-center px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase
                                     text-teal-cyan-aqua-700 bg-teal-cyan-aqua-50 rounded-md border border-teal-cyan-aqua-100">
                            @CaseStudyService.GetProjectCategory(project.Category)
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="px-6 pb-6">
                        <p class="text-gray-600 text-sm mb-5 line-clamp-3 leading-relaxed">
                            @CaseStudyService.GetCustomerFriendlyDescription(project.Description)
                        </p>

                        @if (project.Results != null && project.Results.Any())
                        {
                            <div class="mb-5">
                                <h4 class="text-[10px] font-semibold text-teal-cyan-aqua-600 uppercase tracking-[0.14em] mb-2.5">Key results</h4>
                                <ul class="space-y-1.5">
                                    @foreach (var result in project.Results.Take(2))
                                    {
                                        <li class="flex items-start text-xs text-gray-700 leading-relaxed">
                                            <svg class="w-4 h-4 mr-2 flex-shrink-0 mt-0.5 text-teal-cyan-aqua-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                            </svg>
                                            <span>@CaseStudyService.GetSimplifiedResult(result)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Footer: status + GitHub -->
                        <div class="border-t border-gray-100 pt-4 mt-4 flex justify-between items-center text-xs text-gray-500">
                            <span class="inline-flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5 text-teal-cyan-aqua-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                @project.Status
                            </span>
                            @if (!string.IsNullOrEmpty(project.GithubUrl))
                            {
                                <a href="@project.GithubUrl" target="_blank" rel="noopener"
                                   class="inline-flex items-center gap-1.5 font-medium text-gray-700 hover:text-teal-cyan-aqua-700 transition-colors">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                                    </svg>
                                    View code
                                </a>
                            }
                        </div>
                    </div>
                </div>
                caseIndex++;
            }
        </div>

        <!-- Call-to-Action Section -->
        <div class="text-center">
            <div class="inline-flex flex-col sm:flex-row gap-4 items-center">
                <!-- Primary CTA — single arrow, shimmer + orange glow per design system -->
                <a href="/whoiam?scroll=highlighted-projects"
                   class="btn-shimmer group inline-flex items-center gap-2 px-8 py-4 bg-orange-400 text-teal-cyan-aqua-900 font-semibold rounded-full
                          shadow-lg shadow-orange-400/30
                          hover:bg-orange-500 hover:shadow-xl hover:shadow-orange-500/40
                          transition-all duration-300 active:scale-95">
                    Explore all projects
                    <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </a>
                <!-- Secondary CTA Text -->
                <p class="text-gray-500 text-sm">
                    Want to see similar results? <a href="#contact" class="text-teal-cyan-aqua-600 font-semibold hover:text-teal-cyan-aqua-400">Let's talk</a>
                </p>
            </div>
        </div>
    </div>
</section>

