
@* Section: Feature highlights with alternating text/image layout. *@

<section id="features" class="py-12 md:py-16 bg-gradient-to-br from-teal-cyan-aqua-50/20 to-teal-cyan-aqua-50/5">
    @for (int i = 0; i < _features.Count; i++)
    {
        <div class="@(i % 2 != 0 ? "reveal-right" : "reveal-left")">
            <FeatureHighlightCard Feature="@_features[i]" IsReversed="@(i % 2 != 0)" />
        </div>
    }
</section>
